# Provider — required.
# OPENAI_API_KEY must be set unless every CHORUS_PROVIDER_* is switched away from "openai".
OPENAI_API_KEY=
# Optional: OpenAI-compatible base URL (DashScope, Volcengine Ark, …)
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Per-role models. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL_HOST=gpt-4o-mini
OPENAI_MODEL_ROLE=gpt-4o-mini
OPENAI_MODEL_SUMMARY=gpt-4o-mini

# Provider implementation per role (default: openai). Currently only "openai" is wired.
# CHORUS_PROVIDER_HOST=openai
# CHORUS_PROVIDER_ROLE=openai
# CHORUS_PROVIDER_SUMMARY=openai

# === Database ===
# Local dev: leave TURSO_* unset; CHORUS_DB_PATH points at a local SQLite file.
CHORUS_DB_PATH=./chorus.db

# Production (Vercel + Turso): set both. Get them from `turso db show <name>` and
# `turso db tokens create <name>`. When TURSO_DATABASE_URL is set, CHORUS_DB_PATH
# is ignored.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
